# ═══════════════════════════════════════════════════════════════════════════════
# BlueAgle Server — Environment Variables Template (.env.example)
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to:
#   .env.local  → for local development (runs with: npm run dev)
#   .env        → for production deployment (runs with: npm start)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── Database (MySQL) ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=blueeagle
DB_USER=root
DB_PASS=your_db_password_here
DB_DIALECT=mysql

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,https://blueeagle.in,https://blueagle-client.onrender.com,https://blueagle-server.onrender.com


# ── App URLs ──────────────────────────────────────────────────────────────────
SITE_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
APP_URL=https://blueagle-server.onrender.com

# ── JWT Secrets ───────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_generate_with_crypto_randomBytes
ADMIN_JWT_SECRET=your_admin_jwt_secret_here_generate_with_crypto_randomBytes
ADMIN_JWT_EXPIRY=15m
ADMIN_REFRESH_TOKEN_EXPIRY=7d

# ── Initial Super Admin ───────────────────────────────────────────────────────
INITIAL_ADMIN_EMAIL=superadmin@example.com
INITIAL_ADMIN_PASSWORD=YourStrongAdminPassword123!
INITIAL_ADMIN_FIRSTNAME=Super
INITIAL_ADMIN_LASTNAME=Admin

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n","client_email":"your-service-account@your-project-id.iam.gserviceaccount.com"}

# ── ImageKit (Image CDN) ──────────────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# ── Google Analytics 4 ────────────────────────────────────────────────────────
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_ANALYTICS_MEASUREMENT_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
